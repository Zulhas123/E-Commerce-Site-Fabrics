@{
    var title = ViewData["Title"] as string;
    var pageTitle = string.IsNullOrWhiteSpace(title) ? "E-Commerce" : title;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle - Fabrics</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    @RenderSection("Head", required: false)
</head>
<body class="app-body">
<header class="border-bottom bg-white">
    <nav class="navbar navbar-expand-lg container py-3">
        <a class="navbar-brand fw-semibold" asp-area="Customer" asp-controller="Home" asp-action="Index">Fabrics</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link" asp-area="Customer" asp-controller="Home" asp-action="Index">Shop</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="Customer" asp-controller="Home" asp-action="Cart">Cart</a>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Admin</a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" asp-area="Admin" asp-controller="Products" asp-action="Index">Products</a></li>
                        <li><a class="dropdown-item" asp-area="Admin" asp-controller="ProductTypes" asp-action="Index">Product Types</a></li>
                        <li><a class="dropdown-item" asp-area="Admin" asp-controller="SpacialTag" asp-action="Index">Special Tags</a></li>
                        <li><a class="dropdown-item" asp-area="Admin" asp-controller="Role" asp-action="Index">Roles</a></li>
                    </ul>
                </li>
            </ul>
            <partial name="_LoginPartial" />
        </div>
    </nav>
</header>

<main class="container my-4">
    <partial name="_Alerts" />
    @RenderBody()
</main>

<footer class="border-top py-4">
    <div class="container small text-muted d-flex justify-content-between">
        <span>© @DateTime.UtcNow.Year Fabrics</span>
        <span class="d-none d-sm-inline">Clean Architecture sample</span>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@RenderSection("Scripts", required: false)
</body>
</html>

