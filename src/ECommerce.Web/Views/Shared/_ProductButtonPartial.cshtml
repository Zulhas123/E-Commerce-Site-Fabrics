@model int

<div class="btn-group btn-group-sm" role="group" aria-label="Product actions">
    <a asp-action="Edit" asp-controller="Products" class="btn btn-outline-primary" asp-route-id="@Model">Edit</a>
    <a asp-action="Details" asp-controller="Products" class="btn btn-outline-secondary" asp-route-id="@Model">Details</a>
    <a asp-action="Delete" asp-controller="Products" class="btn btn-outline-danger" asp-route-id="@Model">Delete</a>
</div>

