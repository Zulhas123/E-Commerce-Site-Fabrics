@model IEnumerable<E_Commerce_System.Models.ApplicationUser>
@{
    ViewData["Title"] = "Users";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Users</h1>
    <a asp-action="Create" class="btn btn-sm btn-primary">New</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
            <tr>
                <th>Username</th>
                <th>First name</th>
                <th>Last name</th>
                <th>Status</th>
                <th class="text-end"></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                var locked = item.LockoutEnd.HasValue && item.LockoutEnd.Value > DateTimeOffset.UtcNow;
                <tr>
                    <td class="fw-medium">@item.UserName</td>
                    <td>@item.FirstName</td>
                    <td>@item.LastName</td>
                    <td>
                        @if (locked)
                        {
                            <span class="badge text-bg-warning">Locked</span>
                        }
                        else
                        {
                            <span class="badge text-bg-success">Active</span>
                        }
                    </td>
                    <td class="text-end">
                        <partial name="_UserPartial" model="@item.Id" />
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

