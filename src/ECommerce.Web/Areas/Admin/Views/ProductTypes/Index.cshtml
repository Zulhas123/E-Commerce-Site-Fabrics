@model IEnumerable<E_Commerce_System.Models.ProductTypes>
@{
    ViewData["Title"] = "Product Types";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Product types</h1>
    <a asp-action="Create" class="btn btn-sm btn-primary">New</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
            <tr>
                <th>@Html.DisplayNameFor(c => c.ProductType)</th>
                <th class="text-end"></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-medium">@item.ProductType</td>
                    <td class="text-end">
                        <partial name="_ButtonPartial" model="item.Id" />
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

