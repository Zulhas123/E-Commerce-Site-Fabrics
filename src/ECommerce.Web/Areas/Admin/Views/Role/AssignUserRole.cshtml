@{
    ViewData["Title"] = "User Role Mapping";
}

<h1 class="h4 mb-3">User role mapping</h1>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
            <tr>
                <th>User</th>
                <th>Role</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in ViewBag.UserRoles)
            {
                <tr>
                    <td class="fw-medium">@item.UserName</td>
                    <td>@item.RoleName</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

