@model IEnumerable<E_Commerce_System.Models.Products>
@{
    ViewData["Title"] = "Products";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h4 mb-0">Products</h1>
    <a asp-action="Create" class="btn btn-sm btn-primary">New</a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="post" class="row g-2 align-items-end">
            <div class="col-sm-4 col-md-3">
                <label class="form-label small text-muted" for="lowamount">Min price</label>
                <input id="lowamount" type="number" class="form-control" name="lowamount" placeholder="0" />
            </div>
            <div class="col-sm-4 col-md-3">
                <label class="form-label small text-muted" for="largeamount">Max price</label>
                <input id="largeamount" type="number" class="form-control" name="largeamount" placeholder="9999" />
            </div>
            <div class="col-sm-4 col-md-2">
                <button type="submit" class="btn btn-outline-secondary w-100">Filter</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
            <tr>
                <th>@Html.DisplayNameFor(c => c.Name)</th>
                <th>@Html.DisplayNameFor(c => c.Price)</th>
                <th>@Html.DisplayNameFor(c => c.ProductColor)</th>
                <th>@Html.DisplayNameFor(c => c.IsAvailable)</th>
                <th>Type</th>
                <th>Tag</th>
                <th class="text-end"></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-medium">@item.Name</td>
                    <td>@item.Price</td>
                    <td>@item.ProductColor</td>
                    <td>@(item.IsAvailable ? "Yes" : "No")</td>
                    <td>@item.productType?.ProductType</td>
                    <td>@item.SpacialTag?.spacialTag</td>
                    <td class="text-end">
                        <partial name="_ButtonPartial" model="item.Id" />
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

